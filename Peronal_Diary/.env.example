# ============================================================
# VisualImpairedDiaryDB — Environment Configuration
# ============================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# Database (MS SQL Server)
DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost/VisualImpairedDiaryDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Redis (caching, rate limiting, celery broker)
REDIS_URL=redis://localhost:6379/0

# File Uploads
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE_MB=50

# AI Services (fill when implementing)
WHISPER_MODEL=base
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4

# Gold Price API (zakat nisab)
GOLD_API_KEY=

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Push Notifications
FCM_SERVER_KEY=
